<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider-systemextension</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.bragi0.SimpleVPN</string>
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- No keychain-access-groups: the extension runs as root in the system
	     context and can't read the user's keychain anyway; credentials are handed
	     to it in-memory via startTunnel(options:). Dropping the group is least-
	     privilege and signing-safe (entitlements may be a subset of the profile). -->
</dict>
</plist>
