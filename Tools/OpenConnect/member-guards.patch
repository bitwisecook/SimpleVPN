+int openconnect_check_full_sha256_pin(struct openconnect_info *vpninfo, const char *pin)
+{
+	const char *actual = openconnect_get_peer_cert_hash(vpninfo);
+	char hex[72] = "sha256:";
+	if (!pin || !actual || !*pin)
+		return -EINVAL;
+	if (!strncmp(pin, "pin-sha256:", 11))
+		return strcmp(pin, actual) ? -EINVAL : 0;
+	if (!strchr(pin, ':') && !strncmp(actual, "pin-sha256:", 11) && !strcmp(pin, actual + 11))
+		return 0;
+	if (!strncmp(pin, "sha256:", 7))
+		pin += 7;
+	if (strlen(pin) != 64 || strspn(pin, "0123456789abcdefABCDEF") != 64)
+		return -EINVAL;
+	memcpy(hex + 7, pin, 65);
+	return openconnect_check_peer_cert_hash(vpninfo, hex);
+}
+
+void openconnect_set_member_guards(struct openconnect_info *vpninfo, openconnect_member_socket_vfn socket_guard,
+                                   openconnect_member_pin_vfn pin_guard)
+{
+    vpninfo->managed_tun = 1;
+    vpninfo->member_socket = socket_guard;
+    vpninfo->member_pin = pin_guard;
+}
+
 void openconnect_set_protect_socket_handler(struct openconnect_info *vpninfo,
 					    openconnect_protect_socket_vfn protect_socket)
 {
