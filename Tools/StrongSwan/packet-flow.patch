+METHOD(blocking_queue_t, try_enqueue, bool,
+    private_blocking_queue_t *this, void *item, unsigned int limit)
+{
+    bool accept;
+    this->mutex->lock(this->mutex);
+    accept = this->list->get_count(this->list) < limit;
+    if (accept)
+    {
+        this->list->insert_first(this->list, item);
+        this->condvar->signal(this->condvar);
+    }
+    this->mutex->unlock(this->mutex);
+    return accept;
+}
