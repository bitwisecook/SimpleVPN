# Xcode
DerivedData/
*.xcuserstate
xcuserdata/

# XcodeGen output — project.yml is the source of truth (run `xcodegen generate`)
SimpleVPN.xcodeproj/

# OpenVPN engine build outputs — regenerate with Tools/build-openvpn3-xcframework.sh
build/
Vendor/

# Python tool cache
__pycache__/

# 1Password native SDK bridge: track the Go source, lockfiles and stable header
# (the built libopnative.a stays untracked — Tools/build-onepassword-sdk.sh and
# CI rebuild it reproducibly from the pinned go.mod/go.sum).
!Vendor/
Vendor/*
!Vendor/onepassword-native/
Vendor/onepassword-native/*
!Vendor/onepassword-native/src/
!Vendor/onepassword-native/include/
