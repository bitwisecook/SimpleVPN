# Xcode
DerivedData/
*.xcuserstate
xcuserdata/

# XcodeGen output — project.yml is the source of truth (run `xcodegen generate`)
SimpleVPN.xcodeproj/

# OpenVPN engine build outputs — regenerate with Tools/build-openvpn3-xcframework.sh
build/
Vendor/

# Python tool cache
__pycache__/

# 1Password native SDK bridge: track the Go source, lockfiles and stable header
# (the built libopnative.a stays untracked — Tools/build-onepassword-sdk.sh and
# CI rebuild it reproducibly from the pinned go.mod/go.sum).
!Vendor/
Vendor/*
!Vendor/onepassword-native/
Vendor/onepassword-native/*
!Vendor/onepassword-native/src/
!Vendor/onepassword-native/include/

# Tailscale/Headscale engine (the same Go-as-c-archive deal): track the shim
# source, the pinned lockfiles and the stable header; the ~50 MB libtsengine.a
# is rebuilt by Tools/build-tailscale-engine.sh from the pinned tailscale.com
# version, so it never belongs in git.
!Vendor/tailscale-engine/
Vendor/tailscale-engine/*
!Vendor/tailscale-engine/src/
!Vendor/tailscale-engine/include/
# `go build ./...` in the shim directory drops an executable named after the
# module; the archive build never produces it, but a stray one must not be
# committed.
Vendor/tailscale-engine/src/tsengine

# Proxy-tunnel engine (tun2socks-style gVisor netstack → SOCKS5/CONNECT). Same
# Go-as-c-archive deal: track the shim source, the pinned lockfiles and the
# stable header; the built libpxengine.a (a STANDALONE verification build — the
# engine actually ships folded into libtsengine.a) is rebuilt reproducibly by
# Tools/build-proxy-engine.sh and never belongs in git.
!Vendor/proxy-engine/
Vendor/proxy-engine/*
!Vendor/proxy-engine/src/
!Vendor/proxy-engine/include/
# Stray executables from `go build ./...` in the shim directory.
Vendor/proxy-engine/src/pxengine
Vendor/proxy-engine/src/carchive/carchive

# Agent worktrees (transient, self-contained git repos)
.claude/worktrees/
